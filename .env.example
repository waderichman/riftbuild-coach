PORT=3000
RIOT_API_KEY=
RIOT_REGION=americas
RIOT_PLATFORM=na1
PATCH_VERSION=latest

# Neon/Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=
CRON_SECRET=
INGEST_WORKER_URL=
INGEST_WORKER_SECRET=

# Ingestion config
RIOT_QUEUE=420
RIOT_MATCH_COUNT=20
RIOT_MAX_SEEDS=0
RIOT_REQUEST_DELAY_MS=180
RIOT_MAX_RETRIES=6
RIOT_MIN_GAMES=3
RIOT_DEFAULT_RANK_TIER=CHALLENGER
RIOT_SEED_PUUIDS=

# Seed discovery config
RIOT_SEED_QUEUE=RANKED_SOLO_5x5
RIOT_SEED_PLATFORMS=na1,euw1,kr
RIOT_SEED_LIMIT=50
RIOT_SEED_TIERS=CHALLENGER,GRANDMASTER,MASTER,DIAMOND,EMERALD,PLATINUM,GOLD
RIOT_SEED_DELAY_MS=90
RIOT_SEED_MAX_RETRIES=5

# Recommendation quality filters
RECOMMEND_MIN_SAMPLE_SIZE=3
RECOMMEND_MAX_BUCKET_DISTANCE=2

# Vercel batched cron ingest
RIOT_CRON_SEEDS_PER_RUN=16
RIOT_CRON_MATCHES_PER_SEED=12
RIOT_CRON_ALLOW_QUEUE_FALLBACK=true

